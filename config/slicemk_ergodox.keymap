#define LAYER_MAIN 0
#define LAYER_FN 1

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
// #include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
	keymap {
		compatible = "zmk,keymap";
		layer_0 {
			bindings = <
				&bootloader
				&kp GRAVE        &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3   &kp NUMBER_4    &kp NUMBER_5   &kp DELETE       &kp BACKSPACE     &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8   &kp NUMBER_9  &kp NUMBER_0  &kp MINUS
				&kp TAB          &kp Q        &kp W        &kp E          &kp R           &kp T          &kp RETURN       &kp RETURN        &kp Y        &kp U        &kp I          &kp O         &kp P         &kp BACKSLASH
				&kp CAPSLOCK     &kp A        &kp S        &kp D          &kp F           &kp G                                             &kp H        &kp J        &kp K          &kp L         &kp SEMICOLON &kp PLUS
				&kp LEFT_SHIFT   &kp Z        &kp X        &kp C          &kp V           &kp B          &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp N        &kp M        &kp COMMA      &kp PERIOD    &kp SLASH     &kp RIGHT_SHIFT
				&kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &kp LEFT_ARROW &kp RIGHT_ARROW                                                                &kp UP_ARROW &kp DOWN_ARROW &kp RIGHT_ALT &kp RIGHT_GUI &kp RIGHT_CONTROL
				                                                                          &kp ESCAPE     &kp HOME         &kp END           &kp EQUAL
				                                                          &kp SPACE       &to LAYER_MAIN &kp PAGE_UP      &kp PAGE_DOWN     &mo LAYER_FN &kp SPACE
				                                                                                         &mo LAYER_FN     &mo LAYER_FN
			>;
		};
		layer_1 {
			bindings = <
				&bootloader
				&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &none &none &none &none   &none   &none   &none   &bootloader
				&out OUT_USB &kp F1       &kp F2       &kp F3       &kp F4       &none &none &none &none &kp F13 &kp F14 &kp F15 &kp F16 &rgb_ug RGB_TOG
				&out OUT_BLE &kp F5       &kp F6       &kp F7       &kp F8       &none             &none &kp F17 &kp F18 &kp F19 &kp F20 &none
				&none        &kp F9       &kp F10      &kp F11      &kp F12      &none &none &none &none &kp F21 &kp F22 &kp F23 &kp F24 &none
				&none        &none        &none        &none        &none                                &none   &none   &none   &none   &none
				                                                                 &none &none &none &none
				                                                    &none        &none &none &none &none &none
				                                                                       &none &none
			>;
		};
	};
};
